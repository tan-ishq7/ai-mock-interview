# ============================================================
#  AI Mock Interview — Environment Variables
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to git.
# ============================================================


# ------------------------------------------------------------
# LLM PROVIDER — pick one: claude | gemini | openai
# claude is the default and works best with this codebase.
# ------------------------------------------------------------
LLM_PROVIDER=claude


# ------------------------------------------------------------
# ANTHROPIC / CLAUDE API KEY
#
# Where to get it:
#   1. Go to https://console.anthropic.com
#   2. Sign up / log in
#   3. Go to "API Keys" in the left sidebar
#   4. Click "Create Key"
#   5. Copy the key (starts with sk-ant-...)
#
# Free tier: $5 credit on signup. One full interview costs ~$0.25.
# Model used: claude-sonnet-4-20250514
# ------------------------------------------------------------
ANTHROPIC_API_KEY=


# ------------------------------------------------------------
# GEMINI API KEY (optional — only needed if LLM_PROVIDER=gemini)
#
# Where to get it:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Sign in with Google account
#   3. Click "Create API Key"
#   4. Copy the key (starts with AIza...)
#
# Free tier: very generous — good for development.
# Model used: gemini-2.5-flash (falls back to gemini-2.0-flash)
# ------------------------------------------------------------
GEMINI_API_KEY=


# ------------------------------------------------------------
# OPENAI API KEY (optional — only needed if LLM_PROVIDER=openai)
# Currently commented out in code. Set LLM_PROVIDER=openai to enable.
#
# Where to get it:
#   1. Go to https://platform.openai.com/api-keys
#   2. Sign in → "API Keys" → "Create new secret key"
#   3. Copy the key (starts with sk-proj-...)
#
# Note: Requires prepaid credits. Uncomment openai code in
#       backend/resume/parser.py and backend/interview/engine.py
# ------------------------------------------------------------
OPENAI_API_KEY=


# ------------------------------------------------------------
# ELEVENLABS — Text-to-Speech for interviewer voice
#
# Where to get it:
#   1. Go to https://elevenlabs.io
#   2. Sign up → click your profile (top right) → "API Keys"
#   3. Copy the API key (starts with sk_...)
#
# Voice ID:
#   1. Go to https://elevenlabs.io/voice-library
#   2. Pick any voice → click it → copy the Voice ID from the URL
#      or from the voice detail page
#   3. Paste it below
#
# Free tier: 10,000 characters/month (~5 interviews worth of TTS)
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ------------------------------------------------------------
# SUPABASE — Database (Postgres + pgvector + REST API)
#
# Where to get these:
#   1. Go to https://supabase.com → sign up / log in
#   2. Click "New project" → give it a name → set a DB password → Create
#   3. Wait ~2 minutes for the project to provision
#   4. Go to Project Settings → API (left sidebar)
#
#   SUPABASE_URL:              Copy "Project URL"  (https://xxxx.supabase.co)
#   SUPABASE_ANON_KEY:         Copy "anon public" key  (eyJ...)
#   SUPABASE_SERVICE_ROLE_KEY: Copy "service_role" key (eyJ...)
#                              WARNING: Never expose service_role to the frontend.
#                              It bypasses Row Level Security.
#
# IMPORTANT: After filling these in, you MUST run the SQL schema.
# See supabase_schema.sql — open the Supabase SQL Editor and run it.
#
# Free tier note: Projects pause after 7 days of no activity.
# To restore: dashboard → your project → "Restore project" (takes ~2 min, no data loss)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
